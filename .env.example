# Telegram Bot credentials
BOT_NAME=your_bot_name
BOT_TOKEN=your_bot_token_from_botfather

# Telegram Mini App
# Сгенерируйте 64-символьный hex-ключ (32 байта) командой: openssl rand -hex 32
JWT_SECRET=generate_with_openssl_rand_hex_32

# URL и Origin для Cloudflare quick tunnel (dev) или production домена
MINI_APP_URL=
MINI_APP_ORIGIN=http://localhost:18081
